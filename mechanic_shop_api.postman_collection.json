{
  "info": {
    "name": "Mechanic Shop API - BackendP2",
    "description": "Collection covering customer auth, tickets, mechanics, and inventory endpoints for the assignment continuation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://127.0.0.1:5000"},
    {"key": "customerId", "value": "1"},
    {"key": "mechanicId", "value": "1"},
    {"key": "ticketId", "value": "1"},
    {"key": "inventoryId", "value": "1"},
    {"key": "token", "value": ""}
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/",
          "path": [""]
        }
      }
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Token User\",\n  \"email\": \"token@example.com\",\n  \"phone\": \"111-222-3333\",\n  \"password\": \"secret123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers/",
              "path": ["customers", ""]
            }
          }
        },
        {
          "name": "Customer Login",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"token@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers/login",
              "path": ["customers", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('token', data.token || '');",
                  "pm.collectionVariables.set('customerId', String(data.customer_id || pm.collectionVariables.get('customerId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "My Tickets",
          "request": {
            "method": "GET",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": {
              "raw": "{{baseUrl}}/customers/my-tickets",
              "path": ["customers", "my-tickets"]
            }
          }
        },
        {
          "name": "Get Customers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/customers/?page=1&per_page=10",
              "path": ["customers", ""],
              "query": [
                {"key": "page", "value": "1"},
                {"key": "per_page", "value": "10"}
              ]
            }
          }
        },
        {
          "name": "Get Customer By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}",
              "path": ["customers", "{{customerId}}"]
            }
          }
        },
        {
          "name": "Update Customer (Token Required)",
          "request": {
            "method": "PUT",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"222-333-4444\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}",
              "path": ["customers", "{{customerId}}"]
            }
          }
        },
        {
          "name": "Delete Customer (Token Required)",
          "request": {
            "method": "DELETE",
            "header": [
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}",
              "path": ["customers", "{{customerId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Mechanics",
      "item": [
        {
          "name": "Create Mechanic",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sam\",\n  \"specialty\": \"Engine Diagnostics\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/mechanics/",
              "path": ["mechanics", ""]
            }
          }
        },
        {
          "name": "Get Mechanics",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/mechanics/",
              "path": ["mechanics", ""]
            }
          }
        },
        {
          "name": "Mechanic Leaderboard",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/mechanics/leaderboard",
              "path": ["mechanics", "leaderboard"]
            }
          }
        },
        {
          "name": "Update Mechanic",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"specialty\": \"Brakes\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/mechanics/{{mechanicId}}",
              "path": ["mechanics", "{{mechanicId}}"]
            }
          }
        },
        {
          "name": "Delete Mechanic",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/mechanics/{{mechanicId}}",
              "path": ["mechanics", "{{mechanicId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Service Tickets",
      "item": [
        {
          "name": "Create Service Ticket",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": {{customerId}},\n  \"vin\": \"VIN12345\",\n  \"issue_description\": \"Brake and tire service\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/service-tickets/",
              "path": ["service-tickets", ""]
            }
          }
        },
        {
          "name": "Get Service Tickets",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/service-tickets/",
              "path": ["service-tickets", ""]
            }
          }
        },
        {
          "name": "Assign Mechanic",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/service-tickets/{{ticketId}}/assign-mechanic/{{mechanicId}}",
              "path": ["service-tickets", "{{ticketId}}", "assign-mechanic", "{{mechanicId}}"]
            }
          }
        },
        {
          "name": "Remove Mechanic",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/service-tickets/{{ticketId}}/remove-mechanic/{{mechanicId}}",
              "path": ["service-tickets", "{{ticketId}}", "remove-mechanic", "{{mechanicId}}"]
            }
          }
        },
        {
          "name": "Edit Ticket Mechanics",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"add_ids\": [{{mechanicId}}],\n  \"remove_ids\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/service-tickets/{{ticketId}}/edit",
              "path": ["service-tickets", "{{ticketId}}", "edit"]
            }
          }
        },
        {
          "name": "Add Part to Ticket",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"inventory_id\": {{inventoryId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/service-tickets/{{ticketId}}/parts",
              "path": ["service-tickets", "{{ticketId}}", "parts"]
            }
          }
        }
      ]
    },
    {
      "name": "Inventory",
      "item": [
        {
          "name": "Create Inventory Item",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Oil Filter\",\n  \"price\": 18.5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/inventory/",
              "path": ["inventory", ""]
            }
          }
        },
        {
          "name": "Get Inventory By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/inventory/{{inventoryId}}",
              "path": ["inventory", "{{inventoryId}}"]
            }
          }
        },
        {
          "name": "Get Inventory",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/inventory/",
              "path": ["inventory", ""]
            }
          }
        },
        {
          "name": "Update Inventory",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 22.0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/inventory/{{inventoryId}}",
              "path": ["inventory", "{{inventoryId}}"]
            }
          }
        },
        {
          "name": "Delete Inventory",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/inventory/{{inventoryId}}",
              "path": ["inventory", "{{inventoryId}}"]
            }
          }
        }
      ]
    }
  ]
}
